{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chess-gantry/board-state.schema.json",
  "title": "Chess gantry persistent board state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "pieces", "processed_events"],
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 1 } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "pieces": {
            "additionalProperties": {
              "not": {
                "properties": { "status": { "const": "buffered" } },
                "required": ["status"]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "revision": { "type": "integer", "minimum": 0 },
    "processed_events": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$" }
    },
    "pieces": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "x", "y"],
            "properties": {
              "status": { "const": "board" },
              "x": { "type": "integer", "minimum": 0, "maximum": 7 },
              "y": { "type": "integer", "minimum": 0, "maximum": 7 },
              "metadata": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "x", "y", "capture_slot"],
            "properties": {
              "status": { "const": "captured" },
              "x": { "type": "null" },
              "y": { "type": "null" },
              "capture_slot": { "type": "integer", "minimum": 0 },
              "metadata": { "type": "object" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "x", "y", "machine_x", "machine_y"],
            "properties": {
              "status": { "const": "buffered" },
              "x": { "type": "null" },
              "y": { "type": "null" },
              "machine_x": { "type": "number" },
              "machine_y": { "type": "number" },
              "metadata": { "type": "object" }
            }
          }
        ]
      }
    }
  }
}
