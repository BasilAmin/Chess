{
  "serial": {
    "port": "/dev/ttyUSB0",
    "baudrate": 115200,
    "fallback_baudrates": [115200, 250000],
    "read_timeout_s": 0.25,
    "write_timeout_s": 2.0,
    "command_timeout_s": 300.0,
    "startup_wait_s": 2.5,
    "verify_marlin": true,
    "handshake_timeout_s": 5.0
  },

  "board": {
    "width": 8,
    "height": 8,
    "square_size_mm": 40.0,
    "origin_x_mm": 40.0,
    "origin_y_mm": 18.0,
    "flip_x": false,
    "flip_y": true,
    "swap_xy": false
  },
  "workspace": {
    "min_x_mm": 0.0,
    "max_x_mm": 330.0,
    "min_y_mm": 0.0,
    "max_y_mm": 300.0
  },
  "motion": {
    "travel_feed_mm_min": 3000.0,
    "drag_feed_mm_min": 600.0,
    "magnet_on_dwell_ms": 300,
    "magnet_off_dwell_ms": 300,
    "park_after_move": true,
    "park_x_mm": 315.0,
    "park_y_mm": 300.0
  },
  "magnet": {
    "on_commands": ["M106 P0 S255"],
    "off_commands": ["M107 P0"]
  },
  "planner": {
    "kind": "astar",
    "grid_step_mm": 5.0,
    "obstacle_keepout_mm": 12.0,
    "allow_diagonal": true,
    "simplify_path": true,
    "max_expanded_nodes": 100000
  },
  "capture": {
    "enabled": true,
    "mode": "eject",
    "slots": [],
    "eject_points": [
      [0.0, 0.0],
      [0.0, 300.0]
    ],
    "buffer_points": [
      [10.0, 0.0],
      [10.0, 300.0]
    ],
    "magnetic_keepout_mm": 30.0
  },
  "safety": {
    "calibrated": true,
    "home_before_execute": false,
    "home_commands": ["G28 X Y Z", "M400", "G92 X2 Y298 Z328", "M400"],
    "preflight_commands": ["M115"],
    "emergency_stop_command": "M112"
  }
}
